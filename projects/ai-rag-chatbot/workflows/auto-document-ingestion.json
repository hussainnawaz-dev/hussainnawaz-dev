      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst hash = crypto.createHash('md5').update(buffer).digest('hex');\n\nreturn {\n  json: {\n    ...$input.item.json,\n    file_hash: hash\n  },\n  binary: $input.item.binary\n};"
      },
