    {
      "parameters": {
        "jsCode": "const mammoth = require('mammoth');\n\nconst binaryPropertyName = 'data';\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryPropertyName);\n\nconst result = await mammoth.extractRawText({ buffer: buffer });\n\nreturn {\n  json: {\n    text: result.value\n  }\n};"
