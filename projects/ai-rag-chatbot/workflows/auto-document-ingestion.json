      "parameters": {
        "jsCode": "const response = $input.all();\nconst isDuplicate = response.some(item => item.json && item.json.id !== undefined && item.json.id !== null);\n\nreturn [{\n  json: {\n    ...$('Calculate File Hash').item.json,\n    is_duplicate: isDuplicate\n  },\n  binary: $('Calculate File Hash').item.binary\n}];"
      },
