      "id": "1fd87ed7-30c0-4b2e-be14-d04023100b95",
      "name": "Clean HTML"
    },
    {
      "parameters": {
        "jsCode": "const aiEmailResponse = $json.output?.[0]?.content?.[0]?.text || '';\nconst cleanedEmail = aiEmailResponse.trim();\n\nconst finalEmail = (cleanedEmail.toLowerCase().includes('not found') || cleanedEmail === '') \n  ? 'Not Found' \n  : cleanedEmail;\n\nreturn {\n  json: {\n    business_name: $('Loop Over Items').item.json.title,\n    website: $('Loop Over Items').item.json.website,\n    phone: \"'\" + ($('Loop Over Items').item.json.phone || ''),\n    address: $('Loop Over Items').item.json.address,\n    emails_found: finalEmail\n  }\n};"
      },
