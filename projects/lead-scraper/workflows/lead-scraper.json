    {
      "parameters": {
        "jsCode": "let html = $input.item.json.data || $input.item.json.body || '';\n\nlet cleaned = html\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<!--[\\s\\S]*?-->/g, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\n// 8000 characters tak rakho (start + end dono cover ho, footer bhi aa jaye)\nif (cleaned.length > 8000) {\n  cleaned = cleaned.substring(0, 4000) + ' ... ' + cleaned.substring(cleaned.length - 4000);\n}\n\nreturn {\n  json: {\n    ...$('Loop Over Items').item.json,\n    cleaned_text: cleaned\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
