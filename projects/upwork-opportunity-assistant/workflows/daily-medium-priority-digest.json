      "name": "Get row(s) in sheet"
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\nif (rows.length === 0) {\n  return { json: { hasJobs: false, digestText: \"\", jobIds: [] } };\n}\n\nlet digestText = `<h3>Daily Medium-Priority Job Digest (${rows.length} jobs)</h3>`;\n\nrows.forEach((job, index) => {\n  digestText += `<p><b>${index + 1}. ${job.title}</b><br>`;\n  digestText += `Score: ${job.score}/100<br>`;\n  digestText += `Link: <a href=\"${job.job_url}\">${job.job_url}</a></p>`;\n});\n\nreturn {\n  json: {\n    hasJobs: true,\n    digestText: digestText,\n    jobIds: rows.map(j => j.job_id)\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
